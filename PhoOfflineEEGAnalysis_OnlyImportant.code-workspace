{
	"folders": [
		{
			"name": "PhoOfflineEEGAnalysis",
			"path": "."
		},
		{
			"path": "../mne-python"
		},
		{
			"path": "../mnelab"
		}
	],
	"settings": {
		"workbench.colorCustomizations": {
			"editor.lineHighlightBackground": "#1073cf2d",
			"editor.lineHighlightBorder": "#9fced11f",
			"activityBar.background": "#153015",
			"titleBar.activeBackground": "#0f5819",
			"titleBar.activeForeground": "#dbba00",
			"scrollbarSlider.background": "#fffb0057",
			"scrollbarSlider.hoverBackground": "#fffb0082",
			"scrollbarSlider.activeBackground": "#1db100df",
			"activityBar.inactiveForeground": "#ffffff3c",
			"activityBar.foreground": "#ffffff",
			"notebook.outputContainerBackgroundColor": "#395a3e50",
			"notebook.outputContainerBorderColor": "#1a5c1a",
			"notebook.focusedCellBorder": "#ffff00da",
			"notebook.focusedEditorBorder": "#f6ff00",
			"notebook.inactiveFocusedCellBorder": "#ffff0063",
			"titleBar.inactiveBackground": "#53c7628e",
			"tab.activeBorder": "#2F3C2E",
			"statusBar.background": "#263825",
			"statusBar.foreground": "#ffffff",
			"sideBarSectionHeader.border": "#cecece"
		},
		"git.ignoreLimitWarning": true,
		"python.languageServer": "None",
		"actionButtons": {
			"reloadButton": "↻",
			"loadNpmCommands": false,
			"defaultColor": "grey",
			"commands": [
				{
					"name": "$(play) Analyze Run",
					"tooltip": "Run main_analyze_run.py (discover/process XDFs + update session catalog)",
					"color": "#7CFC00",
					"useVsCodeApi": true,
					"command": "workbench.action.tasks.runTask",
					"args": ["Analyze Run"]
				},
				{
					"name": "$(window) Offline Manager",
					"tooltip": "Open Offline Analysis Manager (calendar, discovery, video catalog, process)",
					"color": "#4FC3F7",
					"useVsCodeApi": true,
					"command": "workbench.action.tasks.runTask",
					"args": ["Offline Manager"]
				},
				{
					"name": "$(search) Discover Sessions",
					"tooltip": "Lightweight XDF discovery into session catalog (no processing)",
					"color": "#FFD54F",
					"useVsCodeApi": true,
					"command": "workbench.action.tasks.runTask",
					"args": ["Discover Sessions"]
				}
			]
		}
	},
	"extensions": {
		"recommendations": [
			"jkearins.action-buttons-ext"
		]
	}
}